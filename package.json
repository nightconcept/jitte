{
  "name": "jitte",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "version": "0.2.0-beta.14",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt --write '**/*.{js,ts,json}'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:all": "pnpm format && pnpm lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "theme:generate": "node theme/parse-schemes.js",
    "theme:list": "node theme/parse-schemes.js --check",
    "fetch-salt-scores": "tsx scripts/fetch-salt-scores.ts",
    "update-ban-lists": "tsx scripts/update-ban-lists.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsdom": "^27.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.10.5",
    "@vitest/ui": "^5.0.1",
    "jsdom": "^27.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mana-font": "^1.18.0"
  }
}
